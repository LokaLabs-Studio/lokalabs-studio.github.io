---
import StaggerHeading from '../StaggerHeading.astro';

const rules = [
  {
    title: 'Yours to keep',
    body: 'No subscriptions. Every feature is free, and if you want to support us, it’s a one-time thing you choose.',
  },
  {
    title: 'No accounts',
    body: 'Nothing to sign up for and no password to forget. Open the app and it’s ready.',
  },
  {
    title: 'Your data stays on your phone',
    body: 'What you record lives in a database on your device. We don’t run servers that could see it.',
    note: 'If Android backup is on, your phone may copy app data to your own Google account. That copy is yours too.',
  },
  {
    title: 'No forced ads',
    body: 'No banners and no pop-ups. If an ad ever plays, it’s because you tapped a button asking for one.',
  },
];
---

<section class="principles" aria-labelledby="principles-title">
  <div class="container">
    <StaggerHeading id="principles-title" class="principles__title" text="The rules we build by." />
    <ol class="rules" role="list" data-reveal>
      {
        rules.map((r, i) => (
          <li class="rule" data-stagger>
            <span class="rule__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="rule__title">{r.title}</h3>
            <div class="rule__body">
              <p>{r.body}</p>
              {r.note && <p class="rule__note">{r.note}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .principles {
    padding-block: var(--section);
    border-top: 1px solid var(--line);
  }
  .principles__title {
    font-size: var(--step-3);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin-bottom: var(--s-8);
    max-width: 14ch;
  }
  .rules {
    border-bottom: 1px solid var(--line);
  }
  .rule {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--s-3) var(--s-4);
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .rule__n {
    font-family: var(--font-code);
    font-size: var(--step--1);
    color: var(--ink-2);
    padding-top: 0.6em;
  }
  .rule__title {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .rule__body {
    grid-column: 2;
    display: grid;
    gap: var(--s-2);
    max-width: 34rem;
    color: var(--ink-2);
  }
  .rule__note {
    font-size: var(--step--1);
    padding-left: var(--s-3);
    border-left: 1px solid var(--line-strong);
  }

  @media (min-width: 56rem) {
    .rule {
      grid-template-columns: 4rem minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--s-6);
      padding-block: var(--s-7);
    }
    .rule__title {
      font-size: clamp(1.75rem, 1.2rem + 1.5vw, 2.75rem);
    }
    .rule__body {
      grid-column: 3;
      padding-top: 0.4em;
    }
  }
</style>
