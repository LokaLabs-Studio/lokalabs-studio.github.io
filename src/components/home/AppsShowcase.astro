---
import StaggerHeading from '../StaggerHeading.astro';
import AppCard from '../apps/AppCard.astro';
import { getApps } from '../../lib/apps';

const apps = await getApps();
---

<section class="showcase" aria-labelledby="apps-title">
  <div class="container">
    <div class="showcase__head">
      <StaggerHeading id="apps-title" class="showcase__title" text="Out of the lab." />
      <p class="showcase__lead" data-reveal>
        Each app replaces something you’d usually pay for every month, and keeps your stuff on your phone.
      </p>
    </div>

    <div class="bento" data-reveal>
      {
        apps.map((app) => (
          <div class="bento__main" data-stagger>
            <AppCard app={app} />
          </div>
        ))
      }
      <aside class="bento__next" data-stagger aria-label="What’s next">
        <p class="label">Next up</p>
        <p class="bento__next-title">In the lab now.</p>
        <p class="bento__next-body">Another app you’d normally rent. No date and no hype until it’s ready to keep.</p>
        <span class="bento__bars" aria-hidden="true"><i></i><i></i></span>
      </aside>
    </div>
  </div>
</section>

<style>
  .showcase {
    padding-block: var(--section);
    border-top: 1px solid var(--line);
  }
  .showcase__head {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-8);
  }
  .showcase__title {
    font-size: var(--step-3);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .showcase__lead {
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 36ch;
  }

  .bento {
    display: grid;
    gap: var(--s-4);
  }
  .bento__main {
    display: grid;
  }
  .bento__next {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: clamp(var(--s-5), 4vw, var(--s-7));
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-lg);
    min-height: 16rem;
    overflow: hidden;
  }
  .bento__next-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .bento__next-body {
    color: var(--ink-2);
    max-width: 26ch;
  }
  .bento__bars {
    position: absolute;
    right: clamp(var(--s-5), 4vw, var(--s-7));
    bottom: 0;
    display: flex;
    gap: 0.625rem;
    height: 40%;
    align-items: flex-end;
  }
  .bento__bars i {
    display: block;
    height: 100%;
    background: var(--line-strong);
  }
  .bento__bars i:first-child {
    width: 1.875rem;
  }
  .bento__bars i:last-child {
    width: 0.4375rem;
  }

  @media (min-width: 56rem) {
    .showcase__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .showcase__lead {
      justify-self: end;
    }
    .bento {
      grid-template-columns: 2fr 1fr;
    }
  }
</style>
