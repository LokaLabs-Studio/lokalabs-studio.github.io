---
import ButtonLink from '../ButtonLink.astro';

interface Props {
  title: string;
  sub: string;
  cta: { href: string; label: string };
}
const { title, sub, cta } = Astro.props;
---

<section class="hero on-brand" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">{title}</h1>
      <p class="hero__sub">{sub}</p>
      <ButtonLink href={cta.href} variant="on-brand">{cta.label}</ButtonLink>
    </div>
    <svg class="hero__bars" viewBox="0 0 47 120" preserveAspectRatio="xMaxYMax meet" aria-hidden="true" focusable="false">
      <rect class="hero__bar hero__bar--a" width="30" height="120"></rect>
      <rect class="hero__bar hero__bar--b" x="40" width="7" height="120"></rect>
    </svg>
  </div>
  <div class="hero__sentinel" data-header-sentinel></div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    background: var(--brand);
    color: var(--on-brand);
    overflow: clip;
  }
  @supports (min-height: 100dvh) {
    .hero {
      min-height: max(36rem, 100dvh);
    }
  }

  .hero__inner {
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: end;
    padding-top: calc(var(--header-h) + env(safe-area-inset-top) + var(--s-6));
  }

  .hero__copy {
    grid-row: 2;
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    padding-bottom: clamp(var(--s-7), 8vh, var(--s-9));
    max-width: 44rem;
  }
  .hero__title {
    font-size: var(--step-hero);
    font-weight: 800;
    line-height: 0.93;
    letter-spacing: -0.045em;
    max-width: 11ch;
    padding-bottom: 0.04em;
  }
  .hero__sub {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 38ch;
    margin-bottom: var(--s-2);
  }

  .hero__bars {
    grid-row: 1;
    align-self: end;
    width: auto;
    height: clamp(8rem, 30svh, 16rem);
    margin-bottom: var(--s-6);
    fill: var(--on-brand);
    overflow: visible;
  }
  .hero__bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  @media (min-width: 56rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr;
      column-gap: var(--s-8);
    }
    .hero__copy {
      grid-row: 1;
      grid-column: 1;
    }
    .hero__bars {
      grid-row: 1;
      grid-column: 2;
      align-self: end;
      height: min(72svh, 44rem);
      margin: 0;
    }
  }

  .hero__sentinel {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.intro) .hero__bar {
      animation: bar-rise 1100ms var(--ease-out) both;
    }
    :global(html.intro) .hero__bar--a {
      animation-delay: 120ms;
    }
    :global(html.intro) .hero__bar--b {
      animation-delay: 260ms;
    }

    @supports (animation-timeline: view()) {
      .hero__bars {
        animation: bars-sink linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes bar-rise {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes bars-sink {
    to {
      transform: translateY(18%);
    }
  }
</style>
