---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DocList from '../components/apps/DocList.astro';
import { getApps } from '../lib/apps';
import { formatDate, isoDate } from '../lib/format';

const apps = await getApps();
const website = (await getEntry('legal', 'studio/website'))!;
const { Content: WebsiteContent } = await render(website);
---

<BaseLayout
  title="Legal"
  description="Privacy policies, terms and data deletion guides for every Loka Labs app, plus how this website handles your visit."
  page="legal-hub"
>
  <div class="container hub">
    <header class="hub__head">
      <p class="label">Legal</p>
      <h1 class="hub__title">Every promise, written down.</h1>
      <p class="lead">
        Privacy policies, terms and deletion guides for each app. Each document opens with a plain-language summary.
      </p>
    </header>

    {
      apps.map((app) => (
        <section class="hub__app" aria-labelledby={`hub-${app.id}`} data-reveal>
          <div class="hub__app-head on-app" data-app-theme={app.id}>
            <Image src={app.data.icon} alt="" width={56} height={56} densities={[1, 2]} class="hub__icon" />
            <div>
              <h2 id={`hub-${app.id}`} class="hub__app-name" translate="no">
                {app.data.name}
              </h2>
              <p class="hub__pkg label" translate="no">
                {app.data.packageId}
              </p>
            </div>
          </div>
          <DocList app={app} />
        </section>
      ))
    }

    <section class="hub__site" id="this-website" aria-labelledby="site-title" data-reveal>
      <div class="hub__site-head">
        <h2 id="site-title" class="hub__site-title">This website</h2>
        <p class="hub__meta">
          Version {website.data.version} · Last updated{' '}
          <time datetime={isoDate(website.data.updated)}>{formatDate(website.data.updated)}</time>
        </p>
      </div>
      <div class="prose">
        <WebsiteContent />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hub {
    display: grid;
    gap: var(--s-8);
    padding-block: var(--s-8) var(--section);
  }
  .hub__head {
    display: grid;
    gap: var(--s-4);
    max-width: 44rem;
  }
  .hub__title {
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .hub__app {
    display: grid;
    gap: var(--s-5);
  }
  .hub__app-head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4);
    border-radius: var(--r-lg);
    background: var(--app-bg);
    border: 1px solid var(--app-border);
    color: var(--app-text);
  }
  .hub__icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 22%;
  }
  .hub__app-name {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }
  .hub__pkg {
    color: var(--app-text-2);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .hub__site {
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-7);
    border-top: 1px solid var(--line);
  }
  .hub__site-title {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }
  .hub__meta {
    margin-top: var(--s-2);
    font-family: var(--font-code);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (min-width: 64rem) {
    .hub {
      grid-template-columns: 5fr 7fr;
      column-gap: var(--s-9);
    }
    .hub__head {
      grid-column: 1 / -1;
    }
    .hub__app,
    .hub__site {
      grid-column: 1 / -1;
      grid-template-columns: 5fr 7fr;
      column-gap: var(--s-9);
      align-items: start;
    }
  }
</style>
